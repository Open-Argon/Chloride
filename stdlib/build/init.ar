import "path" as path
import "file" as file
import "lib_path" expose lib_path
import "subprocess" as subprocess

let includeFolder = path.resolve(path.dirname(program.exc), "..", "include")

let __build__ = load_native_code(path.resolve(program.file.directory, "native", "bin", "build" + platform.lib_ext))

let __compilers__ = __build__.build_detect_compilers().sort((a, b) = b.priority - a.priority)

class CompilerError(Exception) null


class Compiler do
  this.__init__(self, language) = do
    self.language = language

    # All detected compilers (of any target) that support this
    # language, highest priority first. Which specific one gets used
    # for a given build is resolved lazily in resolve_compiler(),
    # since that depends on self.target_os, which can change later
    # via .target()/.build_for_targets().
    self.candidates = __compilers__.filter((compiler) = language in compiler.languages)

    if (!self.candidates.length) do
      throw RuntimeError(`No compiler detected for language '$(language)'`)

    self.sources = []
    self.includes = []
    self.defines = []
    self.library_paths = []
    self.libraries = []
    self.link_items = []
    self.flags = []

    # Tables passed to .library_if()/.flag_if()/.link_if()/
    # .include_if()/.library_path_if(), kept as-is (not resolved yet)
    # so they can be re-evaluated against whichever self.target_os is
    # active each time args() runs -- this matters for
    # .build_for_targets(), which changes self.target_os in a loop
    # after the fluent chain (and these *_if() calls in it) have
    # already run once.
    self.conditional_libraries = []
    self.conditional_flags = []
    self.conditional_link_items = []
    self.conditional_includes = []
    self.conditional_library_paths = []

    self.is_shared = false
    self.output_directory = null
    self.output_name = null
    self.output_file = null

    # Defaults to the host platform, i.e. a normal same-platform build.
    # Call .target(os) to ask for a specific target ("linux", "darwin",
    # "windows", "freebsd"), e.g. when producing a bin/ folder with
    # precompiled binaries for every OS the package supports.
    self.target_os = platform.os

    # Defaults to the host architecture. Call .arch(name) to ask for a
    # specific architecture ("x86_64", "x86", "arm64", "arm", etc.),
    # e.g. when producing separate arm64/x86_64 binaries for the same
    # OS. Combined with target_os to pick a compiler and to lay out
    # output under <directory>/<os>/<arch>/...
    self.target_arch = platform.arch

    # Optional preferred compiler name (e.g. "gcc"), set via .prefer().
    # null means "just take the highest-priority candidate that can
    # reach the target."
    self.preferred_compiler_name = null

  this.target(self, os) = do
    self.target_os = os
    return self

  this.arch(self, arch) = do
    self.target_arch = arch
    return self

  # Prefer a specific detected compiler by its short name (the same
  # names build_detect_compilers() reports, e.g. "gcc", "clang",
  # "x86_64-w64-mingw32-gcc"). Still falls back to the normal
  # priority-ordered search if the preferred one isn't detected or
  # can't reach the current target -- this is a preference, not a
  # hard requirement.
  this.prefer(self, name) = do
    self.preferred_compiler_name = name
    return self

  # True once .target()/.arch() has asked for something other than
  # the host platform/architecture, i.e. we're actually attempting to
  # cross compile.
  this.is_cross_compiling(self) = self.target_os != platform.os || self.target_arch != platform.arch

  # Picks the best detected compiler for self.target_os/self.target_arch:
  #   - native build (target matches host exactly): any compiler whose
  #     cross_target and cross_arch are both null (i.e. it's a normal
  #     host compiler).
  #   - cross build: a compiler whose cross_target equals the
  #     requested target_os AND whose cross_arch equals the requested
  #     target_arch (e.g. "x86_64-w64-mingw32-gcc" reports
  #     cross_target == "windows", cross_arch == "x86_64").
  # Respects .prefer() when the preferred compiler is present and
  # eligible; otherwise picks the highest-priority eligible candidate.
  # Returns null if nothing detected can reach this exact target at all.
  this.resolve_compiler(self) = do
    let eligible = self.candidates.filter((compiler) = do
      if (self.is_cross_compiling()) return compiler.cross_target == self.target_os && compiler.cross_arch == self.target_arch
      return compiler.cross_target == null && compiler.cross_arch == null
    )

    if (!eligible.length) return null

    if (self.preferred_compiler_name != null) do
      let preferred = eligible.filter((compiler) = compiler.name == self.preferred_compiler_name)
      if (preferred.length) return preferred[0]

    # self.candidates is already priority-sorted (inherited from
    # __compilers__), so the first eligible entry is the best pick.
    return eligible[0]

  this.shared(self) = do
    self.is_shared = true
    return self

  this.source(self, *sources) = do
    self.sources.append(*sources)
    return self

  this.include(self, *includes) = do
    self.includes.append(*includes)
    return self

  # Same idea as library_if, but for -I / include-path entries that
  # only apply on certain target platforms (e.g. a vendored source
  # tree on Linux vs a prebuilt SDK's include dir on Windows).
  # Resolved lazily against self.target_os, same reason as the other
  # *_if() methods.
  this.include_if(self, table) = do
    self.conditional_includes.append(table)
    return self

  this.define(self, *defines) = do
    self.defines.append(*defines)
    return self

  this.library_path(self, *paths) = do
    self.library_paths.append(*paths)
    return self

  # Same idea as library_if, but for -L / library-search-path entries
  # that only apply on certain target platforms.
  this.library_path_if(self, table) = do
    self.conditional_library_paths.append(table)
    return self

  # Platform-specific libraries that don't map to a real -lname on every
  # platform (e.g. pthread/dl are implicit on Windows). Pass a dict like
  # {"linux": ["pthread", "dl"], "darwin": ["pthread"], "windows": []}
  # or just call .library(...) directly if you already know it's portable.
  #
  # Resolved against self.target_os lazily, at args()/build() time --
  # not right here -- so this works correctly inside
  # .build_for_targets(), where target_os changes after the fluent
  # chain has already run once.
  this.library_if(self, table) = do
    self.conditional_libraries.append(table)
    return self

  this.library(self, *libraries) = do
    self.libraries.append(*libraries)
    return self

  # Raw, verbatim tokens appended to the link line after everything
  # else (after sources, before nothing) -- for things that don't fit
  # -lname (a bare static archive path like "libraylib.a", or a
  # pkg-config --libs blob you've already split into tokens). Order
  # relative to other .link() calls is preserved.
  this.link(self, *items) = do
    self.link_items.append(*items)
    return self

  # Same idea as library_if, but for raw link-line tokens (see
  # .link()). Resolved lazily against self.target_os, same reason as
  # library_if/flag_if.
  this.link_if(self, table) = do
    self.conditional_link_items.append(table)
    return self

  this.flag(self, *flags) = do
    self.flags.append(*flags)
    return self

  # Same idea as library_if, but for raw compiler flags that only make
  # sense on certain families/platforms (e.g. -fPIC is meaningless/invalid
  # to MSVC). Also resolved lazily against self.target_os, same reason
  # as library_if.
  this.flag_if(self, table) = do
    self.conditional_flags.append(table)
    return self

  # Resolves .library_if()/.flag_if() tables against the current
  # self.target_os. Called fresh inside args() so it's always correct
  # even when target_os changes after these were registered (e.g. in
  # .build_for_targets()'s loop).
  this.resolved_libraries(self) = do
    let libs = array(self.libraries)
    for (table in self.conditional_libraries) do
      libs.append(*table.value_get(self.target_os, []))
    return libs

  this.resolved_flags(self) = do
    let flags = array(self.flags)
    for (table in self.conditional_flags) do
      flags.append(*table.value_get(self.target_os, []))
    return flags

  this.resolved_link_items(self) = do
    let items = array(self.link_items)
    for (table in self.conditional_link_items) do
      items.append(*table.value_get(self.target_os, []))
    return items

  this.resolved_includes(self) = do
    let includes = array(self.includes)
    for (table in self.conditional_includes) do
      includes.append(*table.value_get(self.target_os, []))
    return includes

  this.resolved_library_paths(self) = do
    let paths = array(self.library_paths)
    for (table in self.conditional_library_paths) do
      paths.append(*table.value_get(self.target_os, []))
    return paths

  # Accepts a directory and a *basename* (no prefix, no extension) and
  # lays the compiled shared library out under a per-OS, per-arch
  # subdirectory, using the same convention as the module-level
  # lib_path() function:
  #   <directory>/<target_os>/<target_arch>/<lib_prefix><name><lib_ext>
  # e.g. .output("src/native/bin", "sqlite") on a Linux x86_64 build
  # produces "src/native/bin/linux/x86_64/libsqlite.so", and when
  # cross compiling with .target("windows").arch("x86_64") it produces
  # "src/native/bin/windows/x86_64/sqlite.dll".
  #
  # An application can later find the right binary for whatever
  # platform/architecture it's running on with
  # build.lib_path(directory, name) -- no need to know the naming
  # convention itself.
  #
  # Call .output_exact(...) instead if you want full control over the
  # output path (e.g. for a non-shared executable, or a layout that
  # doesn't follow the per-OS/per-arch convention).
  this.output(self, directory, name) = do
    self.output_directory = directory
    self.output_name = name
    self.output_file = null
    return self

  this.output_exact(self, output) = do
    self.output_directory = null
    self.output_name = null
    self.output_file = output
    return self

  this.resolved_output(self) = do
    if (self.output_file != null) return self.output_file

    if (self.output_directory != null) do
      return lib_path(self.output_directory, self.output_name, self.target_os, self.target_arch)

    throw RuntimeError("No output file specified")

  this.args(self) = do
    if (!self.sources.length) do
      throw RuntimeError("No source files specified")

    let compiler = self.resolve_compiler()
    if (compiler == null) do
      throw CompilerError(`No compiler detected that can build '$(self.language)' for target '$(self.target_os)/$(self.target_arch)'`)

    let output_file = self.resolved_output()

    let libraries = self.resolved_libraries()
    let flags = self.resolved_flags()
    let link_items = self.resolved_link_items()
    let includes = self.resolved_includes()
    let library_paths = self.resolved_library_paths()

    let args = [compiler.path]

    if (compiler.family == "msvc") do
      if (self.is_shared) do
        args.append("/LD")

      for (include in includes) do
        args.append("/I" + include)

      if (file.is_directory(includeFolder)) do
        args.append("/I" + includeFolder)

      for (define in self.defines) do
        args.append("/D" + define)

      for (path in library_paths) do
        args.append("/LIBPATH:" + path)

      for (library in libraries) do
        args.append(library + ".lib")

      args.append(*flags)

      args.append(*self.sources)

      args.append("/Fe:" + output_file)

      args.append(*link_items)

    else if (compiler.family == "gcc") do
      if (self.is_shared) do
        if (self.target_os == "darwin") do
          args.append("-dynamiclib")
          args.append("-Wl,-install_name,@rpath/" + path.basename(output_file))
        else do
          args.append("-shared")

      for (include in includes) do
        args.append("-I")
        args.append(include)

      if (file.is_directory(includeFolder)) do
        args.append("-I")
        args.append(includeFolder)

      for (define in self.defines) do
        args.append("-D")
        args.append(define)

      for (path in library_paths) do
        args.append("-L")
        args.append(path)

      if (self.is_shared && self.target_os != "windows") do
        args.append("-fPIC")

      args.append(*flags)

      # Objects/source files first
      args.append(*self.sources)

      # Static libraries / other explicit link items
      args.append(*link_items)

      # Libraries that satisfy dependencies of the above
      for (library in libraries) do
        args.append("-l")
        args.append(library)

      args.append("-o")
      args.append(output_file)
    else do
      throw RuntimeError(`Compiler family '$(compiler.family)' argument creation logic not implimented.`)

    return args


  # Builds for self.target_os/self.target_arch. Returns true if a
  # binary was produced, false if it was skipped because no detected
  # compiler can reach the requested target (in which case a
  # term.log message explains why, and the developer will need to
  # either provide that platform's binary manually or build it at
  # install time on a matching host).
  this.build(self) = do
    if (self.resolve_compiler() == null) do
      term.log(`[build] No compiler available to build '$(self.language)' for target '$(self.target_os)/$(self.target_arch)' on host '$(platform.os)/$(platform.arch)'. ` +
               `You'll need to provide the '$(self.target_os)/$(self.target_arch)' binary manually, or build it at install time on a matching host.`)
      return false

    let args = self.args()

    let output_file = self.resolved_output()
    file.makedirs(path.dirname(output_file))

    term.log(`[build] $(args.join(" "))`)

    let exit_code = subprocess.run(args)
    if (exit_code) throw CompilerError(`Compiler failed with exit code $(exit_code)`)

    return true

  # Convenience for the common "ship prebuilt binaries for every
  # OS/arch" pattern: build for each (os, arch) pair in targets,
  # skipping (with a term.log explanation) any it can't reach.
  # Doesn't mutate self.target_os/self.target_arch afterwards --
  # they're restored once done.
  #
  # Each entry in targets is a two-element list/tuple [os, arch]:
  #
  #   build.Compiler("c")
  #     .shared()
  #     .source(...)
  #     .output("src/native/bin", "sqlite")
  #     .build_for_targets([
  #       ["linux", "x86_64"],
  #       ["darwin", "x86_64"],
  #       ["darwin", "arm64"],
  #       ["windows", "x86_64"]
  #     ])
  #
  # Since .output() lays each (os, arch) pair out under its own
  # <directory>/<os>/<arch>/ subfolder automatically, builds for
  # different targets never collide or overwrite one another.
  #
  # Returns a dict keyed by "<os>/<arch>" -> true/false (whether that
  # target actually built).
  this.build_for_targets(self, targets) = do
    let original_target_os = self.target_os
    let original_target_arch = self.target_arch
    let results = {}

    for (target in targets) do
      try do
        let target_os = target[0]
        let target_arch = target[1]

        self.target_os = target_os
        self.target_arch = target_arch
        results[`$(target_os)/$(target_arch)`] = self.build()
      catch (CompilerError as e) do
        term.error(e)

    self.target_os = original_target_os
    self.target_arch = original_target_arch
    return results