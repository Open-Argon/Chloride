import "path" as path
import "file" as file
import "subprocess" as subprocess

let includeFolder = path.resolve(path.dirname(program.exc), "..", "include")

let __build__ = load_native_code(path.resolve(program.file.directory, "native", "bin", "build" + platform.lib_ext))

let __compilers__ = __build__.build_detect_compilers().sort((a, b) = b.priority - a.priority)

class CompilerError(Exception) null

class Compiler do
  this.__init__(self, language) = do
    let compiler_filter = __compilers__.filter((compiler) = language in compiler.languages)

    if (compiler_filter.length) do
      self.compiler = compiler_filter[0]
    else do
      throw RuntimeError(`No compiler detected for language '$(language)'`)

    self.sources = []
    self.includes = []
    self.defines = []
    self.library_paths = []
    self.libraries = []
    self.flags = []

    self.is_shared = false
    self.output_file = null
    self.output_is_basename = false

  this.shared(self) = do
    self.is_shared = true
    return self

  this.source(self, *sources) = do
    self.sources.append(*sources)
    return self

  this.include(self, *includes) = do
    self.includes.append(*includes)
    return self

  this.define(self, *defines) = do
    self.defines.append(*defines)
    return self

  this.library_path(self, *paths) = do
    self.library_paths.append(*paths)
    return self

  # Platform-specific libraries that don't map to a real -lname on every
  # platform (e.g. pthread/dl are implicit on Windows). Pass a dict like
  # {"linux": ["pthread", "dl"], "darwin": ["pthread"], "windows": []}
  # or just call .library(...) directly if you already know it's portable.
  this.library_if(self, table) = do
    let libs = table.value_get(platform.os, [])
    if (libs.length) self.libraries.append(*libs)
    return self

  this.library(self, *libraries) = do
    self.libraries.append(*libraries)
    return self

  this.flag(self, *flags) = do
    self.flags.append(*flags)
    return self

  # Same idea as library_if, but for raw compiler flags that only make
  # sense on certain families/platforms (e.g. -fPIC is meaningless/invalid
  # to MSVC).
  this.flag_if(self, table) = do
    let flags = table.value_get(platform.os, [])
    if (flags.length) self.flags.append(*flags)
    return self

  # Accepts a *basename* (no prefix, no extension) and lets the platform
  # decide the rest when building a shared library, e.g. "sqlite" becomes
  # "libsqlite.so" on Linux, "libsqlite.dylib" on macOS, "sqlite.dll" on
  # Windows. Call .output_exact(...) instead if you want full control.
  this.output(self, output) = do
    self.output_file = output
    self.output_is_basename = true
    return self

  this.output_exact(self, output) = do
    self.output_file = output
    self.output_is_basename = false
    return self

  this.resolved_output(self) = do
    if (self.output_file == null) do
      throw RuntimeError("No output file specified")

    if (!self.output_is_basename) return self.output_file

    if (self.is_shared) do
      let name = path.basename(self.output_file)
      return path.with_name(self.output_file, platform.lib_prefix + name + platform.lib_ext)

    return self.output_file

  this.args(self) = do
    if (!self.sources.length) do
      throw RuntimeError("No source files specified")

    let output_file = self.resolved_output()

    let args = [self.compiler.path]

    if (self.compiler.family == "msvc") do
      if (self.is_shared) do
        args.append("/LD")

      for (include in self.includes) do
        args.append("/I" + include)

      if (file.is_directory(includeFolder)) do
        args.append("/I" + includeFolder)

      for (define in self.defines) do
        args.append("/D" + define)

      for (path in self.library_paths) do
        args.append("/LIBPATH:" + path)

      for (library in self.libraries) do
        args.append(library + ".lib")

      args.append(*self.flags)

      args.append(*self.sources)

      args.append("/Fe:" + output_file)

    else if (self.compiler.family == "gcc") do
      if (self.is_shared) do
        args.append("-shared")

      for (include in self.includes) do
        args.append("-I")
        args.append(include)

      if (file.is_directory(includeFolder)) do
        args.append("-I")
        args.append(includeFolder)

      for (define in self.defines) do
        args.append("-D")
        args.append(define)

      for (path in self.library_paths) do
        args.append("-L")
        args.append(path)

      for (library in self.libraries) do
        args.append("-l")
        args.append(library)

      # PIC is implied/required on POSIX for shared libs; harmless to
      # add explicitly, and this is the one flag safe to infer here.
      if (self.is_shared && platform.os != "windows") do
        args.append("-fPIC")

      args.append(*self.flags)

      args.append(*self.sources)

      args.append("-o")
      args.append(output_file)
    else do
      throw RuntimeError(`Compiler family '$(self.compiler.family)' argument creation logic not implimented.`)

    return args


  this.build(self) = do
    let exit_code = subprocess.run(self.args())
    if (exit_code) throw CompilerError(`Compiler failed with exit code $(exit_code)`)