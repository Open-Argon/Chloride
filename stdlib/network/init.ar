import "path" as path
import "json" as json

let __net__ = load_native_code(path.resolve(program.file.directory,"native","bin","network"+platform.lib_ext))

# Option constants mirroring NET_OPT_* in socket.h
let NET_OPT_KEEPALIVE = 1
let NET_OPT_NODELAY   = 2
let NET_OPT_REUSEADDR = 3
let NET_OPT_RCVTIMEO  = 4
let NET_OPT_SNDTIMEO  = 5

# Poll bitmask constants
let NET_POLL_READ  = 1
let NET_POLL_WRITE = 2

class SocketError(Exception) null
class TLSError(Exception) null
class HTTPError(Exception) null

# Whether this build of the native module was compiled with TLS support
# (i.e. linked against OpenSSL). If false, tls_client() will raise TLSError.
let TLS_SUPPORTED = __net__.tls_supported()

class tcp_connection do
  this.__init__(self,socket_id) = do
    self.__socket__ = socket_id
  
  this.send(self,buff) = do
    return __net__.net_send(self.__socket__, buff)

  this.send_string(self,str) = do
    return __net__.net_send_string(self.__socket__, str)
  
  this.recv(self,buff) = do
    return __net__.net_recv(self.__socket__, buff)
  
  this.recv_string(self,size) = do
    return __net__.net_recv_string(self.__socket__, size)
  this.peek(self, buff) = do
    return __net__.net_peek(self.__socket__, buff)

  # Returns a NET_POLL_* bitmask, 0 on timeout, -1 on error.
  # Pass timeout_ms=-1 to block indefinitely.
  this.poll(self, want_read, want_write, timeout_ms) = do
    return __net__.net_poll(self.__socket__, want_read, want_write, timeout_ms)

  this.set_nonblocking(self, enable) = do
    return __net__.net_set_nonblocking(self.__socket__, enable)

  this.set_opt(self, opt, value) = do
    return __net__.net_set_opt(self.__socket__, opt, value)
    
  this.close(self) = do
    return __net__.net_close(self.__socket__)

class tcp do
  this.__refcount__=0

  this.__init__(self,port) = do
    if (!this.__refcount__) __net__.net_init()
    this.__refcount__+=1
    self.__socket__ = __net__.net_listen(port, SocketError)

  this.accept(self) = do
    return tcp_connection(__net__.net_accept(self.__socket__, SocketError))

  this.set_nonblocking(self, enable) = do
    return __net__.net_set_nonblocking(self.__socket__, enable)

  this.set_opt(self, opt, value) = do
    return __net__.net_set_opt(self.__socket__, opt, value)

  this.poll(self, want_read, want_write, timeout_ms) = do
    return __net__.net_poll(self.__socket__, want_read, want_write, timeout_ms)

  this.close(self) = do
    this.__refcount__-=1
    if (!this.__refcount__) __net__.net_cleanup()
    return __net__.net_close(self.__socket__)

class tcp_client do
  this.__init__(self, host, port) = do
    __net__.net_init()
    self.__socket__ = __net__.net_connect(host, port, SocketError)
    self.__conn__   = tcp_connection(self.__socket__)

  this.send(self, buff)= do
    return self.__conn__.send(buff)
  this.send_string(self, str) = do
    return self.__conn__.send_string(str)
  this.recv(self, buff) = do
    return self.__conn__.recv(buff)
  this.recv_string(self, size) = do
    return self.__conn__.recv_string(size)
  this.peek(self, buff) = do
    return self.__conn__.peek(buff)
  this.poll(self, r, w, ms) = do
    return self.__conn__.poll(r, w, ms)
  this.set_nonblocking(self, e) = do
    return self.__conn__.set_nonblocking(e)
  this.set_opt(self, opt, val) = do
    return self.__conn__.set_opt(opt, val)

  this.close(self) = do
    self.__conn__.close()
    __net__.net_cleanup()

class tls_connection do
  this.__init__(self,tls_socket) = do
    self.__tls__ = tls_socket

  this.send(self,buff) = do
    return __net__.tls_send(self.__tls__, buff)

  this.send_string(self,str) = do
    return __net__.tls_send_string(self.__tls__, str)

  this.recv(self,buff) = do
    return __net__.tls_recv(self.__tls__, buff)

  this.recv_string(self,size) = do
    return __net__.tls_recv_string(self.__tls__, size)

  # Returns a NET_POLL_* bitmask, 0 on timeout, -1 on error.
  # Pass timeout_ms=-1 to block indefinitely.
  this.poll(self, want_read, want_write, timeout_ms) = do
    return __net__.tls_poll(self.__tls__, want_read, want_write, timeout_ms)

  this.close(self) = do
    return __net__.tls_close(self.__tls__)

# Client-side TLS socket. Same shape as tcp_client so higher-level code
# (like `http`, below) can use either interchangeably.
#
#   host          - hostname to connect to (also used for SNI + hostname
#                    verification)
#   port          - port to connect to
#   verify_peer   - true (default) to verify the server's certificate chain
#                    and hostname; false disables verification (insecure,
#                    only useful for testing against self-signed certs)
#   ca_path       - optional path to a PEM CA bundle; null uses the system
#                    default trust store
class tls_client(tcp_client) do
  this.__init__(self, host, port, verify_peer=true, ca_path=null) = do
    if (!TLS_SUPPORTED) throw TLSError("this build of the network module was not compiled with TLS support")
    self.__tls__ = __net__.tls_connect(host, port, number(verify_peer), ca_path, TLSError)
    self.__conn__ = tls_connection(self.__tls__)

  this.send(self, buff) = do
    return self.__conn__.send(buff)
  this.send_string(self, str) = do
    return self.__conn__.send_string(str)
  this.recv(self, buff) = do
    return self.__conn__.recv(buff)
  this.recv_string(self, size) = do
    return self.__conn__.recv_string(size)
  this.poll(self, r, w, ms) = do
    return self.__conn__.poll(r, w, ms)

  this.close(self) = do
    self.__conn__.close()

# ---------------------------------------------------------------------
# High-level HTTP client, built on top of tcp_client / tls_client.
#
# Deliberately minimal: HTTP/1.1, one request per connection (Connection:
# close), no redirects, no chunked-transfer streaming beyond simple
# reassembly. Good enough as a base to build a fuller client/abstraction
# on top of, or to use directly for simple request/response needs.
#
# Everything below works in buffers, not strings, until the caller
# explicitly asks for a string (text()/body_string()) - matching how
# the rest of the runtime's socket layer (recv/peek/send) works.
# ---------------------------------------------------------------------

let __CRLF__ = buffer.from_string("\r\n")
let __HEADER_TERM__ = buffer.from_string("\r\n\r\n")
let __COLON_SPACE__ = buffer.from_string(": ")
let __COLON__ = buffer.from_string(":")
let __SPACE__ = buffer.from_string(" ")
let __EMPTY_BUF__ = buffer.of_size(0)

# Default cap on how many bytes of header data we'll buffer while
# looking for the end of the header block (the blank line). This bounds
# memory use / read time for a malicious or misbehaving peer that never
# sends "\r\n\r\n" (a classic slow/never-ending-header DoS).
let __DEFAULT_MAX_HEADER_SIZE__ = 65536

# HTTPResponse only carries the parsed status line + headers up front.
# The body is *not* read eagerly: it's read on demand, either as a
# string (body_string / text) or as a buffer (body_bytes / bytes). Any
# leftover body bytes that arrived attached to the header read are
# folded straight into __body_buf__ at construction time, so callers
# never need to think about "leftovers" - .conn and __body_buf__ are
# just "whatever's left of the body, some possibly already in hand,
# the rest still on the wire".
class HTTPResponse do
  this.__init__(self, status, status_text, headers, conn, leftover, timeout_ms, auto_close=true) = do
    self.status = status
    self.status_text = status_text
    self.headers = headers

    # Raw connection (tcp_connection or tls_connection). Exposed so
    # callers can bypass all of this and read/poll/peek themselves.
    self.conn = conn

    self.__timeout_ms__ = timeout_ms
    self.__auto_close__ = auto_close
    self.__body_done__ = false      # true once we've drained everything there is to drain
    self.__body_buf__ = []          # accumulated body chunks (buffers), once we start reading

    # Fold any bytes read past the header terminator straight in, so
    # nothing downstream has to special-case "leftover" separately from
    # "the rest of the body".
    if (leftover != null && leftover.length > 0) self.__body_buf__.append(leftover)

  this.ok(self) = do
    return self.status >= 200 && self.status < 300

  # content_length(): parsed Content-Length header, or null if absent /
  # not a valid integer (e.g. chunked responses, which aren't unchunked
  # here).
  this.content_length(self) = do
    for (value in self.headers) do
      if (value[0].lower() == "content-length") do
        let n = number(self.headers[value[0]])
        return n

    return

  # __drain_body__(): internal. Pulls whatever's left of the body off
  # the connection (respecting Content-Length if present) and appends
  # it into __body_buf__, as buffers. Safe to call multiple times; a
  # no-op once the body's fully read. This is where the *lazy* read
  # actually happens - nothing here runs until a caller asks for the
  # body.
  
  this.__auto_closer__(self) = self.__auto_close__?self.close():null

  this.__drain_body__(self) = do
    if (self.__body_done__) return
    if (self.conn == null) do
      self.__body_done__ = true
      return

    let want = self.content_length()

    let have = 0
    for (chunk in self.__body_buf__) have += chunk.length

    if (want != null && have >= want) do
      self.__body_done__ = true
      return self.__auto_closer__()

    # No Content-Length: fall back to "read until the peer closes",
    # matching this client's Connection: close behaviour. With
    # Content-Length: read exactly up to `want` bytes.
    while (true) do
      let ready = self.conn.poll(NET_POLL_READ, 0, self.__timeout_ms__)
      if (ready == 0) throw HTTPError("timed out reading response body")
      if (ready < 0) throw HTTPError("connection error while reading response body")

      let chunk_buf = buffer.of_size(65536)
      let n = self.conn.recv(chunk_buf)
      if (n <= 0) break

      let chunk = n < chunk_buf.length ? chunk_buf[:n] : chunk_buf
      self.__body_buf__.append(chunk)
      have += chunk.length
      if (want != null && have >= want) break

    self.__body_done__ = true
    self.__auto_closer__()

  this.pipe(self, callback) = do
    if (self.__body_done__) return
    if (self.conn == null) do
      self.__body_done__ = true
      return

    let want = self.content_length()

    let have = 0
    for (chunk in self.__body_buf__) do
      callback(chunk)
      have += chunk.length

    if (want != null && have >= want) do
      self.__body_done__ = true
      return self.__auto_closer__()

    # No Content-Length: fall back to "read until the peer closes",
    # matching this client's Connection: close behaviour. With
    # Content-Length: read exactly up to `want` bytes.
    while (true) do
      let ready = self.conn.poll(NET_POLL_READ, 0, self.__timeout_ms__)
      if (ready == 0) throw HTTPError("timed out reading response body")
      if (ready < 0) throw HTTPError("connection error while reading response body")

      let chunk_buf = buffer.of_size(65536)
      let n = self.conn.recv(chunk_buf)
      if (n <= 0) break

      let chunk = n < chunk_buf.length ? chunk_buf[:n] : chunk_buf
      callback(chunk)
      have += chunk.length
      if (want != null && have >= want) break

    self.__body_done__ = true
    self.__auto_closer__()

  # __body_buffer__(): internal. All accumulated body chunks merged
  # into a single buffer.
  this.__body_buffer__(self) = do
    self.__drain_body__()
    if (self.__body_buf__.length == 0) return __EMPTY_BUF__
    if (self.__body_buf__.length == 1) return self.__body_buf__[0]

    let merged = buffer.of_size(0)
    for (chunk in self.__body_buf__) merged.extend(chunk)
    # Collapse back down to a single chunk so repeated calls stay cheap.
    self.__body_buf__ = [merged]
    return merged

  # body_bytes() / bytes(): the full body as a buffer. This is the
  # native representation - reading it doesn't cost a string
  # conversion.
  this.body_bytes(self) = do
    return self.__body_buffer__()

  this.bytes(self) = do
    return self.body_bytes()

  # body_string() / text(): the full body as a string. Buffers stay
  # buffers all the way through; the array .map() makes turning a list
  # of chunks into a joined string a one-liner, and to_string() is only
  # called once we actually need text.
  this.body_string(self) = do
    return self.__body_buffer__().to_string()

  this.text(self) = do
    return self.body_string()

  this.json(self) = do
    return json.parse(self.text())

  # close(): close the underlying connection without reading the rest
  # of the body. Use this when you only cared about the headers/status
  # (e.g. a HEAD-style check, or you already got what you needed from
  # self.conn directly) and want to release the socket promptly instead
  # of waiting for GC.
  this.close(self) = do
    if (self.conn != null) do
      self.conn.close()
      self.conn = null
    self.__body_done__ = true

let __http_parse_url__(url) = do
  # Very small URL splitter: scheme://host[:port]/path
  let scheme = "http"
  let rest = url
  let part_pos = url.index_of("://")
  if (part_pos >= 0) do
    let parts = [url[:part_pos], url[part_pos+3:]]
    scheme = parts[0]
    rest = parts[1]

  let path = "/"
  let idx = rest.index_of("/")
  if (idx >= 0) do
    path = rest[idx:]
    rest = rest[:idx]

  let host = rest
  let port =  scheme == "https"?443:80
  let colon_part = rest.index_of(":")
  if (colon_part >= 0) do
    let hp = [rest[:colon_part], rest[colon_part+1:]]
    host = hp[0]
    port = number(hp[1])

  return {"scheme": scheme, "host": host, "port": port, "path": path}

let __http_build_request__(method, path, host, headers, body) = do
  let lines = [method + " " + path + " HTTP/1.1", "Host: " + host]

  let has_content_length = false
  let has_connection = false
  for (key in headers) do
    let lower = key.lower()
    if (lower == "content-length") has_content_length = true
    if (lower == "connection") has_connection = true
    lines.append(key + ": " + headers[key])

  if (body != null && !has_content_length) lines.append("Content-Length: " + str(len(body)))
  if (!has_connection) lines.append("Connection: close")

  let head = lines.join("\r\n") + "\r\n\r\n"
  if (body == null) return head
  return head + body

# __http_read_header__: reads from `conn` in buffer chunks until the
# "\r\n\r\n" header terminator is found, WITHOUT reading the body past
# it. Bails out with HTTPError if the header block exceeds
# max_header_size before a terminator shows up, so a peer that just
# streams headers (or never sends a blank line) can't be used to run us
# out of memory or tie up the connection indefinitely.
#
# Returns {"header_block": <buffer>, "leftover": <buffer>} where
# `leftover` is whatever bytes were read past the terminator (i.e. the
# start of the body, if any arrived in the same recv as the header
# tail). Both are buffers.
let __http_read_header__(conn, max_header_size, timeout_ms) = do
  let buf = buffer.of_size(0)
  while (true) do
    let parts = buf.partition(__HEADER_TERM__)
    if (parts[1].length == __HEADER_TERM__.length) do
      return {"header_block": parts[0], "leftover": parts[2]}

    if (buf.length >= max_header_size) throw HTTPError(
        "response header exceeded max_header_size (" + str(max_header_size) + " bytes) before a terminator was found")

    let ready = conn.poll(NET_POLL_READ, 0, timeout_ms)
    if (ready == 0) throw HTTPError("timed out waiting for response headers")
    if (ready < 0) throw HTTPError("connection error while waiting for response headers")

    # Only read up to the remaining header budget (plus the terminator
    # itself) in one go, so a single oversized recv can't blow past
    # max_header_size either.
    let remaining_budget = max_header_size - buf.length + __HEADER_TERM__.length
    let chunk_buf = buffer.of_size(remaining_budget)
    let n = conn.recv(chunk_buf)
    if (n <= 0) throw HTTPError("connection closed before response headers were complete")

    buf.extend(n < chunk_buf.length ? chunk_buf[:n] : chunk_buf)

let __http_parse_header_block__(header_block) = do
  let header_lines = header_block.split(__CRLF__)
  let status_line = header_lines[0].to_string()
  let status_line_spacing = status_line.index_of(" ")
  let status_parts = [status_line[:status_line_spacing], status_line[status_line_spacing+1:]]
  let status = number(status_parts[1].split(" ")[0])
  let status_text = status_parts.length > 2? status_parts[2] : ""

  let headers = {}
  for (i in 1 until header_lines.length) do
    let line = header_lines[i]
    if (line.length == 0) continue
    let parts = line.partition(__COLON_SPACE__)
    let key = null
    let value = null
    if (parts[1].length > 0) do
      key = parts[0].to_string()
      value = parts[2].to_string()
    else do
      # Fall back to a bare ":" separator (no space) rather than
      # dropping the header entirely.
      let alt = line.partition(__COLON__)
      if (alt[1].length == 0) continue
      key = alt[0].to_string()
      value = alt[2].to_string().strip(" ")
    headers[key] = value

  return {"status": status, "status_text": status_text, "headers": headers}

class http do
  # request: perform a single HTTP or HTTPS request and return an
  # HTTPResponse. `headers` is an optional dictionary; `body` an optional
  # string. `verify_peer`/`ca_path` are forwarded to tls_client for https
  # URLs.
  # max_header_size: cap (in bytes) on how much header data we'll
  # buffer while looking for the "\r\n\r\n" terminator. Protects against
  # a peer that sends an enormous or never-terminated header block.
  # Only the header is read here - the body is left on the connection
  # and read lazily; see HTTPResponse.text()/bytes()/conn.
  this.request(method, url, headers=null, body=null, verify_peer=true,
              ca_path=null, timeout_ms=30000, max_header_size=__DEFAULT_MAX_HEADER_SIZE__, auto_close=true) = do
    let parsed = __http_parse_url__(url)
    let hdrs = headers == null ? {} : headers

    let request_text = __http_build_request__(
        method, parsed["path"], parsed["host"], hdrs, body)

    let conn = null
    if (parsed["scheme"] == "https") do
      conn = tls_client(parsed["host"], parsed["port"], verify_peer, ca_path)
    else do
      conn = tcp_client(parsed["host"], parsed["port"])

    conn.send_string(request_text)

    let header_result = __http_read_header__(conn, max_header_size, timeout_ms)
    let parsed_header = __http_parse_header_block__(header_result["header_block"])

    return HTTPResponse(
        parsed_header["status"], parsed_header["status_text"], parsed_header["headers"],
        conn, header_result["leftover"], timeout_ms, auto_close)

  this.get(url, headers=null, verify_peer=true, ca_path=null, timeout_ms=30000, max_header_size=__DEFAULT_MAX_HEADER_SIZE__) = do
    return this.request("GET", url, headers, null, verify_peer, ca_path, timeout_ms, max_header_size)

  this.post(url, body=null, headers=null, verify_peer=true, ca_path=null, timeout_ms=30000, max_header_size=__DEFAULT_MAX_HEADER_SIZE__) = do
    return this.request("POST", url, headers, body, verify_peer, ca_path, timeout_ms, max_header_size)

  this.put(url, body=null, headers=null, verify_peer=true, ca_path=null, timeout_ms=30000, max_header_size=__DEFAULT_MAX_HEADER_SIZE__) = do
    return this.request("PUT", url, headers, body, verify_peer, ca_path, timeout_ms, max_header_size)

  this.del(url, headers=null, verify_peer=true, ca_path=null, timeout_ms=30000, max_header_size=__DEFAULT_MAX_HEADER_SIZE__) = do
    return this.request("DELETE", url, headers, null, verify_peer, ca_path, timeout_ms, max_header_size)
