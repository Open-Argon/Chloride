# FileError and PathError are the global exception classes, so catching
# either one (through this module or globally) catches every file error.
let FileError = global.FileError
let PathError = global.PathError

class TempDirectoryError(FileError) null
class FileReadError(FileError) null
class FileNotFoundError(FileError) null
class FilePermissionError(FileError) null
class FileExistsError(FileError) null