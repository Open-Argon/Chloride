import "exceptions.ar" expose FileError, FileReadError, FileNotFoundError, FilePermissionError, FileExistsError
import "path" as path

let _file = load_native_code(path.resolve(program.file.directory,"native","bin","file"+platform.lib_ext))

class File do
    this._validate_mode(self, mode) = do
        let valid_base = ["r", "w", "a", "x"]
        let valid_mods = ["b", "+"]

        if (mode.length == 0) do
            throw FileError("mode cannot be empty")

        if (mode[0] not in valid_base) do
            throw FileError("invalid mode: '" + mode + "'")

        let seen = []
        for (char in mode[1:]) do
            if (char not in valid_mods) do
                throw FileError("invalid mode character: '" + char + "'")
            if (char in seen) do
                throw FileError("duplicate mode character: '" + char + "'")
            seen.append(char)

    this.read(self, size?) = do
        if ("r" not in self.mode) throw FileReadError("file not in read mode.")
        if (!size) do
            return _file.read_all(self._handle, self._binary, FileReadError)
        let result = _file.read(self._handle, self._binary, size, FileReadError)
        if (!self._binary && result == null) do
            return ""
        return result
    this.write(self, data) = do
        if ("w" not in self.mode && "a" not in self.mode && "x" not in self.mode && "+" not in self.mode) do
            throw FileError("file not in write mode.")
        if (self.closed) do
            throw FileError("I/O operation on closed file")
        return _file.write(self._handle, data, self._binary, FileError)
    this.close(self) = do
        if (self.closed) do
            return
        _file.close(self._handle, FileError)
        self.closed = true

    this.seek(self, offset, whence=0) = do
        if (self.closed) do
            throw FileError("I/O operation on closed file")
        _file.seek(self._handle, offset, whence, FileError)

    this.tell(self) = do
        if (self.closed) do
            throw FileError("I/O operation on closed file")
        return _file.tell(self._handle, FileError)

    this.flush(self) = do
        if (self.closed) do
            throw FileError("I/O operation on closed file")
        _file.flush(self._handle, FileError)
        
    this.size(self) = do
        if (self.closed) do
            throw FileError("I/O operation on closed file")
        return _file.file_size(self._handle, FileError)
    

let _File_from_handle(name, file, handle, mode) = do
    file.__name__ = path
    file.mode = mode
    file.closed = false
    file._binary  = "b" in mode
    file._handle = handle
    return file

let open(path, mode="r") = do
    let file = File()
    file._validate_mode(mode)
    return _File_from_handle(path, file, _file.open_handle(path, mode, FileNotFoundError, FilePermissionError, FileExistsError, FileError), mode)

class Path_type do
    this.__init__(self, name) = do
        self.__name__ = name

let file_path = Path_type("file")
let directory_path = Path_type("directory")

let path_type(path) = do
    let type = _file.path_type(path)
    if (type == 1) return file_path
    else if (type == 2) return directory_path
    return null

let is_file(path) = path_type(path) == file_path

let is_directory(path) = path_type(path) == directory_path

let stdout = _File_from_handle("stdout", File(), _file.open_stdout(), "wb")
let stderr = _File_from_handle("stderr", File(), _file.open_stderr(), "wb")
let stdin = _File_from_handle("stdin", File(), _file.open_stdin(), "rb")