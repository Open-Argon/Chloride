[settings]
os=Macos
arch=armv8
compiler=apple-clang
compiler.version=16
compiler.libcxx=libc++
build_type=Release

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:compiler_executables={"c":"/opt/osxcross/bin/arm64-apple-darwin24.5-clang","cpp":"/opt/osxcross/bin/arm64-apple-darwin24.5-clang++"}

[buildenv]
CC=/opt/osxcross/bin/arm64-apple-darwin24.5-clang
CXX=/opt/osxcross/bin/arm64-apple-darwin24.5-clang++
AR=/opt/osxcross/bin/arm64-apple-darwin24.5-ar
AS=/opt/osxcross/bin/arm64-apple-darwin24.5-as
LD=/opt/osxcross/bin/arm64-apple-darwin24.5-ld
NM=/opt/osxcross/bin/arm64-apple-darwin24.5-nm
RANLIB=/opt/osxcross/bin/arm64-apple-darwin24.5-ranlib
STRIP=/opt/osxcross/bin/arm64-apple-darwin24.5-strip